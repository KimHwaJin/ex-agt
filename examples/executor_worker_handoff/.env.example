# Worker core. Settings reads these EW_* variables directly.
EW_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/agent
EW_REDIS_URL=redis://redis:6379/0
EW_NAMESPACE=your-agent
EW_EXECUTOR_BASE_URL=http://executor:8000/api/v1
EW_EXECUTOR_EVENT_STREAM=executor.events
EW_EVENT_GROUP_NAME=your-agent:ingress
EW_COMMAND_STREAM_NAME=your-agent:commands
EW_COMMAND_GROUP_NAME=your-agent:dispatch
EW_INSTANCE_ID=worker-pod-uid
EW_INGRESS_CONCURRENCY=4
EW_DISPATCH_CONCURRENCY=4
EW_POOL_SIZE=8
EW_BATCH_SIZE=100
EW_HEALTH_PORT=8011

# Host Agent integration. This DB must contain the Agent's LangGraph
# checkpoint tables. It may be the same physical DB as EW_DATABASE_URL.
AGENT_CHECKPOINT_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/agent
