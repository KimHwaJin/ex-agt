# Local development only. No LLM, PostgreSQL or Redis credentials needed here.
# API and Worker remain in the existing Compose deployment.
CHAT_UI_API_URL=http://127.0.0.1:8010
CHAT_UI_USER_ID=chat-ui-test-user
CHAT_UI_PROJECT_ID=chat-ui-test-project
# Automatically reconcile/reconnect SSE after this interval; no refresh card.
CHAT_UI_WATCH_SECONDS=30
CHAT_UI_REQUEST_TIMEOUT_SECONDS=10
# Do not send test conversation traces to LangSmith by default.
LANGSMITH_TRACING=false
