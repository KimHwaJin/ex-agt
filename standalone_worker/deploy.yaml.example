# Host project must build its own API+Agent image including executor_worker
# and main.py / the completed agent_app.py integration.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: api-agent-worker
spec:
  replicas: 1
  selector:
    matchLabels:
      app: api-agent-worker
  template:
    metadata:
      labels:
        app: api-agent-worker
    spec:
      terminationGracePeriodSeconds: 40
      # Run migrate-job.yaml.example before rollout.
      # Host separately initializes its LangGraph checkpoint tables.
      containers:
        - name: api-agent
          image: your-registry/your-agent:replace-me
          command: [uvicorn, your_agent.api:app]
          args: [--host, 0.0.0.0, --port, '8010']
          envFrom:
            - secretRef:
                name: agent-runtime
          ports:
            - containerPort: 8010
          # API probes must match the recipient's existing application.
        - name: worker
          image: your-registry/your-agent:replace-me
          command: [python, /worker/main.py]
          envFrom:
            - secretRef:
                name: agent-runtime
          env:
            - name: EW_INSTANCE_ID
              valueFrom:
                fieldRef:
                  fieldPath: metadata.uid
          ports:
            - containerPort: 8011
          readinessProbe:
            httpGet:
              path: /health/ready
              port: 8011
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health/live
              port: 8011
            periodSeconds: 10
          startupProbe:
            httpGet:
              path: /health/live
              port: 8011
            failureThreshold: 30
            periodSeconds: 2
