apiVersion: batch/v1
kind: Job
metadata:
  generateName: ex-agent-worker-cutover-preflight-
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 300
  template:
    metadata:
      labels:
        app.kubernetes.io/name: ex-agent-worker-cutover-preflight
    spec:
      restartPolicy: Never
      automountServiceAccountToken: false
      containers:
        - name: preflight
          image: ex-agent:target-version
          args:
            - ex-agent-cutover-check
            - --admission-evidence-url
            - $(BFF_CUTOVER_EVIDENCE_URL)
            - --expected-freeze-id
            - $(CUTOVER_FREEZE_ID)
            - --stable-seconds
            - "10"
          envFrom:
            - configMapRef:
                name: ex-agent-runtime
            - secretRef:
                name: ex-agent-runtime
            - secretRef:
                name: ex-agent-cutover
