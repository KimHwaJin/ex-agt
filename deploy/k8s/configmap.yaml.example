apiVersion: v1
kind: ConfigMap
metadata:
  name: ex-agent-runtime
  labels:
    app.kubernetes.io/name: ex-agent
    app.kubernetes.io/part-of: ex-agent
data:
  APP_ENV: production
  LOG_LEVEL: INFO
  HOST: 0.0.0.0
  PORT: "8010"

  BFF_AUTH_MODE: hmac
  BFF_AUTH_MAX_CLOCK_SKEW_SECONDS: "300"
  BFF_AUTH_NONCE_PREFIX: ex-agent:bff-auth:nonce

  EXECUTOR_BASE_URL: http://executor-api:8000/api/v1
  EXECUTOR_SOURCE_MODE: PATH
  EXECUTOR_SHARED_STORAGE_ROOT: /workspace/shared
  EXECUTOR_RUNTIME_PROFILE: basic
  EXECUTOR_REQUEST_TIMEOUT_SECONDS: "30"
  EXECUTOR_OPERATION_WAIT_TIMEOUT_SECONDS: "3600"

  AGENT_COMMAND_STREAM: agent.commands
  AGENT_COMMAND_CONSUMER_GROUP: agent-workflow-workers-v1
  AGENT_COMMAND_DEAD_LETTER_STREAM: agent.commands.dlq
  AGENT_PRODUCT_EVENT_STREAM: agent.product-events
  AGENT_PRODUCT_EVENT_CHANNEL_PREFIX: agent.task-events
  EXECUTOR_EVENT_STREAM: executor.events
  EXECUTOR_EVENT_CONSUMER_GROUP: agent-executor-events-v1
  EXECUTOR_EVENT_DEAD_LETTER_STREAM: executor.events.agent-dlq
  EXECUTOR_WORKER_NAMESPACE: agent-executor-worker

  AGENT_RECOVERY_CONCURRENCY: "4"
  AGENT_RECOVERY_BATCH_SIZE: "32"
  WORKER_COMMAND_CONCURRENCY: "4"
  WORKER_EXECUTOR_EVENT_CONCURRENCY: "8"
  CHECKPOINT_POOL_MIN_SIZE: "1"
  CHECKPOINT_POOL_MAX_SIZE: "8"
  TASK_LOCK_TTL_SECONDS: "60"
  TASK_LOCK_RENEW_INTERVAL_SECONDS: "10"
  STREAM_CLAIM_BATCH_SIZE: "10"
  COMMAND_MAX_RETRY_ATTEMPTS: "5"
  EXECUTOR_EVENT_MAX_RETRY_ATTEMPTS: "100"
  STREAM_RETRY_STATE_TTL_SECONDS: "604800"
  OUTBOX_POLL_MILLISECONDS: "100"
  OUTBOX_IDLE_MAX_MILLISECONDS: "1000"
  OUTBOX_BATCH_SIZE: "100"
  OUTBOX_CLAIM_TIMEOUT_SECONDS: "30"
  WORKER_SHUTDOWN_GRACE_SECONDS: "25"
  WORKER_METRICS_ENABLED: "true"
  WORKER_METRICS_PORT: "8011"
  READINESS_PROBE_TIMEOUT_SECONDS: "2"

  STREAM_RETENTION_SECONDS: "604800"
  STREAM_MINIMUM_RETAINED_ENTRIES: "1000"
  STREAM_MAINTENANCE_OPERATOR_USER_IDS: ""
  AGENT_FAILURE_OPERATOR_USER_IDS: ""

  AGENT_MODEL: qwen38-27b-nvfp4
  AGENT_MODEL_PROVIDER: openai
  AGENT_MODEL_BASE_URL: http://model.frodo.com/v1
  AGENT_MODEL_TEMPERATURE: "0"
  AGENT_MODEL_ENABLE_THINKING: "false"
  AGENT_EMBEDDING_PROVIDER: dummy
  AGENT_EMBEDDING_MODEL: dummy-hash-v1
  AGENT_EMBEDDING_BASE_URL: http://model.frodo.com/v1
  AGENT_EMBEDDING_DIMENSIONS: "1024"
  AGENT_SKILL_ROOT: /app/skills
