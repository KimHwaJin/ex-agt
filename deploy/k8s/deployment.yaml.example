apiVersion: apps/v1
kind: Deployment
metadata:
  name: ex-agent
  labels:
    app.kubernetes.io/name: ex-agent
    app.kubernetes.io/part-of: ex-agent
spec:
  replicas: 1
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0
      maxSurge: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: ex-agent
  template:
    metadata:
      labels:
        app.kubernetes.io/name: ex-agent
        app.kubernetes.io/part-of: ex-agent
    spec:
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 40
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
      containers:
        - name: api-agent
          image: registry.example.com/ex-agent:replace-with-version
          imagePullPolicy: IfNotPresent
          # Keep the image's tini ENTRYPOINT and replace only Docker CMD.
          args: ["ex-agent-api"]
          envFrom:
            - configMapRef:
                name: ex-agent-runtime
            - secretRef:
                name: ex-agent-runtime
          env:
            - name: BFF_AUTH_HMAC_KEYS_JSON
              valueFrom:
                secretKeyRef:
                  name: ex-agent-bff-auth
                  key: keys-json
          ports:
            - name: http
              containerPort: 8010
          startupProbe:
            httpGet:
              path: /health/live
              port: http
            periodSeconds: 2
            timeoutSeconds: 2
            failureThreshold: 60
          livenessProbe:
            httpGet:
              path: /health/live
              port: http
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /health/ready
              port: http
            periodSeconds: 5
            timeoutSeconds: 3
            failureThreshold: 3
          resources:
            requests:
              cpu: 250m
              memory: 512Mi
            limits:
              cpu: "2"
              memory: 2Gi
          volumeMounts:
            - name: executor-shared
              mountPath: /workspace/shared
        - name: worker
          image: registry.example.com/ex-agent:replace-with-version
          imagePullPolicy: IfNotPresent
          # Keep the image's tini ENTRYPOINT and replace only Docker CMD.
          args: ["ex-agent-worker"]
          envFrom:
            - configMapRef:
                name: ex-agent-runtime
            - secretRef:
                name: ex-agent-runtime
          env:
            - name: WORKER_INSTANCE_ID
              valueFrom:
                fieldRef:
                  fieldPath: metadata.uid
          ports:
            - name: worker-health
              containerPort: 8011
          startupProbe:
            httpGet:
              path: /health/live
              port: worker-health
            periodSeconds: 2
            timeoutSeconds: 2
            failureThreshold: 60
          livenessProbe:
            httpGet:
              path: /health/live
              port: worker-health
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /health/ready
              port: worker-health
            periodSeconds: 5
            timeoutSeconds: 3
            failureThreshold: 3
          resources:
            requests:
              cpu: 250m
              memory: 512Mi
            limits:
              cpu: "2"
              memory: 2Gi
          volumeMounts:
            - name: executor-shared
              mountPath: /workspace/shared
      volumes:
        - name: executor-shared
          persistentVolumeClaim:
            claimName: replace-with-executor-shared-pvc
