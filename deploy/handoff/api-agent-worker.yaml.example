# Historical handoff template, NOT a deployment of the current ex-agent.
# Use deploy/k8s for the current service.
# Replace the image/modules, Secret, Executor URL and PVC before using it.
# The host must implement both entrypoints and the health endpoints below.
apiVersion: v1
kind: ConfigMap
metadata:
  name: handoff-agent-config
data:
  BFF_AUTH_MODE: hmac
  BFF_AUTH_MAX_CLOCK_SKEW_SECONDS: "300"
  BFF_AUTH_NONCE_PREFIX: handoff-agent:bff-auth:nonce
  EXECUTOR_BASE_URL: http://executor-api:8000/api/v1
  EXECUTOR_SOURCE_MODE: PATH
  EXECUTOR_SHARED_STORAGE_ROOT: /workspace/shared
  EXECUTOR_EVENT_STREAM: executor.events
  EXECUTOR_EVENT_CONSUMER_GROUP: handoff-agent-executor-events
  EXECUTOR_WORKER_NAMESPACE: handoff-agent-worker
  AGENT_COMMAND_STREAM: handoff-agent.commands
  AGENT_COMMAND_CONSUMER_GROUP: handoff-agent-command-workers
  AGENT_COMMAND_DEAD_LETTER_STREAM: handoff-agent.commands.dlq
  EXECUTOR_EVENT_DEAD_LETTER_STREAM: executor.events.handoff-agent-dlq
  WORKER_SHUTDOWN_GRACE_SECONDS: "25"
  AGENT_RECOVERY_CONCURRENCY: "4"
  AGENT_RECOVERY_BATCH_SIZE: "32"
  # Empty means deny all BLOCKED failure-cleanup operations.
  AGENT_FAILURE_OPERATOR_USER_IDS: ""
  # Empty means deny all Stream maintenance operations.
  STREAM_MAINTENANCE_OPERATOR_USER_IDS: ""
  STREAM_RETENTION_SECONDS: "604800"
  STREAM_MINIMUM_RETAINED_ENTRIES: "1000"
  STREAM_MAINTENANCE_CONCURRENCY: "2"
  STREAM_MAINTENANCE_BATCH_SIZE: "10"
  STREAM_MAINTENANCE_POLL_SECONDS: "2"
  STREAM_MAINTENANCE_CLAIM_TIMEOUT_SECONDS: "60"
  STREAM_MAINTENANCE_MAX_ATTEMPTS: "5"
  STREAM_MAINTENANCE_RETRY_SECONDS: "5"
  WORKER_METRICS_HOST: "0.0.0.0"
  WORKER_METRICS_PORT: "8011"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: handoff-agent
spec:
  replicas: 1
  selector:
    matchLabels:
      app: handoff-agent
  template:
    metadata:
      labels:
        app: handoff-agent
    spec:
      terminationGracePeriodSeconds: 40
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
      containers:
        - name: api-agent
          image: registry.example.com/your-agent:REPLACE_WITH_VERSION
          # args replaces CMD and keeps the image's tini ENTRYPOINT.
          args:
            - uvicorn
            - your_agent.api:app
            - --host
            - "0.0.0.0"
            - --port
            - "8010"
            - --timeout-graceful-shutdown
            - "25"
          envFrom:
            - configMapRef:
                name: handoff-agent-config
            - secretRef:
                name: handoff-agent-secrets
          env:
            - name: BFF_AUTH_HMAC_KEYS_JSON
              valueFrom:
                secretKeyRef:
                  name: handoff-agent-bff-auth
                  key: keys-json
          ports:
            - name: http
              containerPort: 8010
          startupProbe:
            httpGet:
              path: /health/live
              port: http
            periodSeconds: 2
            failureThreshold: 60
          livenessProbe:
            httpGet:
              path: /health/live
              port: http
            periodSeconds: 10
          readinessProbe:
            httpGet:
              path: /health/ready
              port: http
            periodSeconds: 5
          resources:
            requests:
              cpu: 250m
              memory: 512Mi
            limits:
              cpu: "2"
              memory: 2Gi
          volumeMounts:
            - name: executor-shared
              mountPath: /workspace/shared
        - name: worker
          image: registry.example.com/your-agent:REPLACE_WITH_VERSION
          args: ["python", "-m", "your_agent.worker_main"]
          envFrom:
            - configMapRef:
                name: handoff-agent-config
            - secretRef:
                name: handoff-agent-secrets
          env:
            - name: WORKER_INSTANCE_ID
              valueFrom:
                fieldRef:
                  fieldPath: metadata.uid
          ports:
            - name: worker-health
              containerPort: 8011
          startupProbe:
            httpGet:
              path: /health/live
              port: worker-health
            periodSeconds: 2
            failureThreshold: 60
          livenessProbe:
            httpGet:
              path: /health/live
              port: worker-health
            periodSeconds: 10
          readinessProbe:
            httpGet:
              path: /health/ready
              port: worker-health
            periodSeconds: 5
          resources:
            requests:
              cpu: 250m
              memory: 512Mi
            limits:
              cpu: "2"
              memory: 2Gi
          volumeMounts:
            - name: executor-shared
              mountPath: /workspace/shared
      volumes:
        - name: executor-shared
          persistentVolumeClaim:
            claimName: REPLACE-WITH-EXECUTOR-SHARED-PVC
---
apiVersion: v1
kind: Service
metadata:
  name: handoff-agent-api
spec:
  selector:
    app: handoff-agent
  ports:
    - name: http
      port: 8010
      targetPort: http
  type: ClusterIP

# Only the api-agent container receives this dedicated Secret:
# handoff-agent-bff-auth / keys-json =
# BFF_AUTH_HMAC_KEYS_JSON={"active-key-id":"<base64url-32+-byte-secret>"}
