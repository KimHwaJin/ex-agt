# Replace image and Secret before applying. The image must contain
# /app/worker_migrations (included in our Dockerfile).
# Wait for this Job to complete before rolling out API+Agent / Worker.
apiVersion: batch/v1
kind: Job
metadata:
  name: executor-worker-migrate-ew-0001
spec:
  backoffLimit: 3
  activeDeadlineSeconds: 300
  template:
    spec:
      restartPolicy: Never
      containers:
        - name: migrate
          image: your-registry/your-agent:replace-me
          command: [alembic]
          args: [-c, /app/worker_migrations/alembic.ini, upgrade, head]
          env:
            - name: EW_DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: agent-runtime
                  key: EW_DATABASE_URL
